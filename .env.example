KIS_APP_KEY=your_mock_app_key
KIS_APP_SECRET=your_mock_app_secret
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_CANO=your_account_number_first_8_digits
KIS_ACNT_PRDT_CD=01
TOSS_API_KEY=your_mock_toss_api_key
TOSS_SECRET_KEY=your_mock_toss_secret_key
KIS_TARGET_SYMBOL=005930
SCAN_SYMBOLS=005930,000660,035420
BUY_TARGET_SYMBOLS=005930,000660,035420
KIS_ORDER_QTY=1
BUY_FEE_BPS=1.5
SELL_FEE_BPS=1.5
SELL_TAX_BPS=15.0
BUY_SLIPPAGE_BPS=5.0
SELL_SLIPPAGE_BPS=5.0
EXPECTED_SLIPPAGE_BPS_BASE=5.0
EXPECTED_COST_BLOCK_BPS=35.0
MIN_NET_EDGE_BPS=10.0
MIN_NET_PROFIT_BUFFER_BPS=20.0
USE_COST_AWARE_PNL=true
PERFORMANCE_BENCHMARK_SYMBOL=069500
# 성과 snapshot / cycle snapshot 은 data/*.jsonl, 요약은 logs/*.jsonl 로 자동 저장됩니다.
BUY_RULE_ENABLE_INTRADAY_PULLBACK=true
BUY_RULE_ENABLE_REBOUND_FROM_LOW=true
BUY_RULE_ENABLE_CONTROLLED_DOWN_DAY=true
BUY_RULE_ENABLE_GAP_DOWN_OPEN=true
BUY_RULE_ENABLE_RANGE_RECOVERY=true
BUY_RULE_REBOUND_FROM_LOW_PCT=0.01
BUY_RULE_CONTROLLED_DOWN_DAY_MIN=-6.0
BUY_RULE_CONTROLLED_DOWN_DAY_MAX=0.0
BUY_RULE_GAP_DOWN_OPEN_MIN_PCT=0.3
BUY_RULE_GAP_DOWN_OPEN_MAX_PCT=5.0
BUY_RULE_RANGE_RECOVERY_MIN_RATIO=0.2
BUY_RULE_REQUIRED_PASS_COUNT=3
BUY_MIN_PASSED_COUNT=3
BUY_MIN_SCORE=3.20
BUY_MAX_BUDGET_PER_TRADE_KRW=1000000
BUY_MAX_ACCOUNT_EXPOSURE_PCT=10
BUY_MAX_QTY_PER_TRADE=10
STRICT_SELL_FIRST=true
BLOCK_REBUY_SYMBOLS_BOUGHT_TODAY=false
BUY_BLOCK_ON_BLOCKED_PREVIEW=false
ENABLE_BUY_COOLDOWN=true
ALLOW_ONE_BUY_PER_SYMBOL_PER_DAY=false
BUY_REENTRY_COOLDOWN_MINUTES=30
BUY_SAME_SYMBOL_MAX_ENTRIES_PER_DAY=3
BUY_BLOCKED_COOLDOWN_MINUTES=30
BLOCK_RESELL_SYMBOLS_SOLD_TODAY=true
ENABLE_SELL_COOLDOWN=true
ALLOW_ONE_SELL_TRIGGER_PER_SYMBOL_PER_DAY=true
SELL_BLOCKED_COOLDOWN_MINUTES=30
ORDER_COOLDOWN_MINUTES=15
SELL_ENABLE=true
SELL_RULE_STOP_LOSS_PCT=-3.0
SELL_RULE_TAKE_PROFIT_PCT=3.0
SELL_RULE_TRAILING_STOP_PCT=1.5
ENABLE_SELL_TEST_SCENARIOS=false
ENABLE_SELL_GUARD_SELFTEST=false
SELL_TEST_MODE=off
SELL_EXIT_REQUIRED_PASS_COUNT=0
BUY_ENABLE_RISK_GUARDS=true
BUY_DAILY_MAX_ORDER_SUBMISSIONS=30
SELL_DAILY_MAX_ORDER_SUBMISSIONS=100
BUY_DAILY_MAX_NOTIONAL_KRW=1500000
SELL_DAILY_MAX_NOTIONAL_KRW=7000000
# rebalance는 BUY 후보가 충분히 좋지만 주문가능현금 부족으로 추천 수량이 0주일 때만 SELL 우선 검토합니다.
# 노출 한도 부족 / 1회 예산 부족 / 수량·가격 제약은 즉시 차단 사유로만 남기고 rebalance는 검토하지 않습니다.
# score delta와 net profit buffer는 콘솔과 dashboard에서 이유를 함께 설명합니다.
ENABLE_REBALANCE_SELL=false
ENABLE_QUALITY_REBALANCE_PREVIEW=true
REBALANCE_SELL_MAX_SUBMISSIONS_PER_DAY=1
REBALANCE_MIN_SCORE_DELTA=1.0
REBALANCE_MIN_PROFIT_BUFFER_BPS=0.0
REBALANCE_MAX_CONCENTRATION_PCT=35.0
REBALANCE_MIN_NET_EDGE_BPS=10.0
RUN_MODE=trade
RUN_ONCE=true
RUN_INTERVAL_SECONDS=60
SELL_CHECK_INTERVAL_SECONDS=5
BUY_SCAN_INTERVAL_SECONDS=120
SCAN_SYMBOLS_MAX_PER_CYCLE=40
BUY_SCAN_PROFILE_ROTATION_ENABLED=true
BUY_SCAN_EXPLORATION_RATIO=0.2
BUY_SCAN_CORE_FRACTION=0.4
BUY_SCAN_ROTATING_FRACTION=0.35
BUY_SCAN_SHALLOW_TOP_K=12
BUY_SCAN_DEEP_EVAL_LIMIT=8
BUY_SCAN_TOP_K_CANDIDATES=8
API_SOFT_MAX_REQUESTS_PER_SECOND=3
API_SOFT_MAX_QUOTES_PER_TICK=5
API_BACKOFF_SECONDS_ON_RATE_LIMIT=3
API_MIN_INTER_REQUEST_SECONDS=0.80
API_BUY_SCAN_MIN_REQUEST_RESERVE=2
API_BUY_SCAN_MIN_QUOTE_RESERVE=2
SLACK_ALERTS_ENABLED=false
SLACK_ALERT_DRY_RUN=true
SLACK_ALERT_TIMEOUT_SEC=3
SLACK_ALERT_MIN_INTERVAL_SEC=60
SLACK_NOTIFY_ORDER_SUBMITTED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Outbound Slack alert channels.
# Category-specific channels fall back to SLACK_CHANNEL_PROJECT_OPERATOR when empty.
SLACK_CHANNEL_PROJECT_OPERATOR=
SLACK_CHANNEL_PROJECT_ORDERS=
SLACK_CHANNEL_PROJECT_BOTTLENECKS=
SLACK_CHANNEL_PROJECT_SUMMARY=
SLACK_CHANNEL_PROJECT_PATH_FINDER=
ENABLE_DAILY_PNL_BRAKE=true
DAILY_PNL_WARNING_PCT=-1.5
DAILY_BUY_PAUSE_PCT=-2.5
DAILY_HARD_STOP_PCT=-4.0
DAILY_PNL_COOLDOWN_MINUTES=30
REGIME_CAUTION_DRAWDOWN_PCT=-2.0
REGIME_RISK_OFF_DRAWDOWN_PCT=-4.0
REGIME_NORMAL_MULTIPLIER=1.0
REGIME_CAUTION_MULTIPLIER=0.7
REGIME_RISK_OFF_MULTIPLIER=0.2
ENABLE_PREMARKET_WAIT=true
# shell에서 같은 키를 주면 .env보다 그 값이 우선 적용되며, 실제 적용값은 실행 시 콘솔의 "=== 적용 설정 ==="에서 확인할 수 있습니다.
# SELL 감시는 더 짧은 cadence, BUY 스캔은 120초 cadence로 단일 루프 안에서 분리됩니다.
# BUY는 raw 유니버스 -> layer(core/rotating/exploration) -> pre-gating -> shallow ranking -> deep evaluation 순서로 진행됩니다.
# BUY는 덜 자주 보되 더 넓게 인지하고, 매 cycle에서 profile(momentum/pullback/recovery)을 바꿔 shallow ranking 편향을 줄입니다.
# exploration quota가 rotating/exploration 종목 일부를 deep evaluation shortlist에 남겨, 같은 종목만 계속 보는 현상을 줄입니다.
# BUY 후보가 좋아 보여도 예상 총거래비용이 크거나 비용 반영 후 순우위가 낮으면 진입을 보류할 수 있습니다.
# 새로운 판단 축은 기존 threshold를 일괄 강화하지 않고 score/penalty 중심으로 후보 비교 설명성을 높입니다.
# mean reversion(rolling z-score / OU-inspired)와 portfolio risk overlay(correlation / variance increase)는
# 별도 토글 없이 기본 활성화되며, 데이터가 부족하면 안전하게 설명 전용 fallback으로 동작합니다.
# 수학 overlay는 최종 BUY trigger를 크게 바꾸지 않고 score 설명과 sizing multiplier 보정에 우선 반영됩니다.
# regime-aware sizing은 BUY trigger를 크게 바꾸지 않고, NORMAL / CAUTION / RISK_OFF 상태에 따라
# 1회 예산, 노출 한도, 재진입 cooldown, 동일 종목 진입 강도를 조절합니다.
# regime는 daily pnl brake와 drawdown을 함께 참고하며, 실제 적용값은 엔진 로그와 dashboard 엔진 상태판에서 확인할 수 있습니다.
# 완전 병렬 루프 대신 중앙 API budget으로 KIS 호출량을 보수적으로 제어합니다.
# REGULAR 세션에서 BUY scan due 이면 SELL watch가 최소 BUY reserve(request/quote) 를 전부 잠식하지 않도록 일부 cap 될 수 있습니다.
# 장전(PREMARKET)에 미리 켜 두면 09:00 이후 별도 재실행 없이 자동으로 정상 운영을 시작합니다.
# 현재 구현은 REGULAR 세션에서만 실제 주문을 허용합니다.
CONFIRM_BUY=NO
